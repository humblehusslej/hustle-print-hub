# =============================================================================
# Hustle Print Hub — required environment variables
#
# Copy to .env.local and fill in real values. This file is committed and must
# never contain secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — SERVER-SIDE ONLY
#
# Deliberately no NEXT_PUBLIC_SUPABASE_* variable. NEXT_PUBLIC_ ships a value to
# the browser; the locked architecture is that the browser never holds a
# Supabase key or URL. All database access goes through Server Actions using the
# secret key. The artwork upload uses a server-issued signed URL, so the browser
# needs neither a key nor the project URL.
#
# Do not add the publishable key back as NEXT_PUBLIC_ — the post-build secret
# grep (FOUND-03) will fail the build.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Migrations only, never at runtime. Percent-encode special characters in the
# password (! -> %21, * -> %2A, $ -> %24, @ -> %40).
DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Clerk
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# -----------------------------------------------------------------------------
# Resend
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
QUOTE_NOTIFICATION_TO=owner@example.com
